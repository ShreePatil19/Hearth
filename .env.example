NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Public Coveo search token for the business.gov.au scraper (not a credential).
# When unset, that scraper is skipped. In CI, provide it as the COVEO_SEARCH_TOKEN secret.
COVEO_SEARCH_TOKEN=

# Phase 2 — Community Dashboard
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
CRON_SECRET=
ALERT_WEBHOOK_URL=

# Sentry error tracking (optional). Leave empty to disable.
# When empty: client/server Sentry init becomes a no-op.
# When set: also configure SENTRY_ORG and SENTRY_PROJECT for build-time source map upload (CI only).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Rate limiting (Upstash Redis — free tier, optional for local dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
